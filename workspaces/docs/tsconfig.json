{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"jsx": "react-native",
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"react": ["../../node_modules/@types/react"],
			"react/*": ["../../node_modules/@types/react/*"],
			"react-native-cross-elements": ["../package/src/index.ts"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.d.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts",
		".expo/types/**/*.ts",
		"types/**/*.d.ts"
	]
}
